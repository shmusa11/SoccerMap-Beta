# Copy to .env and edit locally. Never commit credentials.
PNLCALIB_ROOT=/absolute/path/to/PnLCalib
WASB_ROOT=/absolute/path/to/WASB-SBDT
# Optional: your OWN private Roboflow key. See docs/SECRETS.md.
# Leave empty to skip Roboflow officials classification; never commit a real value.
ROBOFLOW_API_KEY=
# Optional: your OWN OpenAI key for the fast pipeline's AI keyframes (teams, roles, ball,
# landmarks). Sends sampled frames to OpenAI; each run has a USD cap. Never commit a value.
OPENAI_API_KEY=
